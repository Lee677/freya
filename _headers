# Cloudflare Pages response headers.
#
# Policy: the vendored libraries are version-pinned and never edited in place,
# so they cache hard. Everything I actually write has an unhashed filename, so
# it stays short-lived and a deploy shows up straight away. HTML is left alone —
# the Pages default (max-age=0, must-revalidate) is already what we want.
#
# If a vendored library is ever swapped for a newer version, change the filename
# (three.r128.min.js) or add a query string in the page, or returning visitors
# will keep the old one for up to a month.

# ── vendored, version-pinned: three.js r128, manifold-3d v3 ────────────────
/freyacad/three.min.js
  Cache-Control: public, max-age=2592000, immutable
/freyacad/manifold.js
  Cache-Control: public, max-age=2592000, immutable
/freyacad/manifold.wasm
  Cache-Control: public, max-age=2592000, immutable
/grid/three.min.js
  Cache-Control: public, max-age=2592000, immutable
/grid/manifold.js
  Cache-Control: public, max-age=2592000, immutable
/grid/manifold.wasm
  Cache-Control: public, max-age=2592000, immutable

# ── my own code ────────────────────────────────────────────────────────────
#
# These MUST NOT outlive the HTML that loads them. index.html revalidates on
# every visit, so any max-age here opens a window where fresh markup is driven
# by stale code — which broke the tool scan on 2026-08-15: the new page had no
# #sc-mode element, ten-minute-old app.js still read it, and every click threw.
# The filenames carry no content hash, so the only safe TTL is zero. Revalidation
# is one conditional request per file, answered 304 from the edge.
/grid/js/*
  Cache-Control: public, max-age=0, must-revalidate

# ── icons ─────────────────────────────────────────────────────────────────
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/freyacad/favicon.ico
  Cache-Control: public, max-age=604800
/freyacad/favicon.svg
  Cache-Control: public, max-age=604800
/grid/favicon.ico
  Cache-Control: public, max-age=604800
/grid/favicon.svg
  Cache-Control: public, max-age=604800
/nextround/favicon.svg
  Cache-Control: public, max-age=604800
/stars/favicon.svg
  Cache-Control: public, max-age=604800
/zen/favicon.svg
  Cache-Control: public, max-age=604800

# ── link-preview cards ────────────────────────────────────────────────────
# Static, and refetched by every scraper that sees a shared link. Regenerated
# only by tools/og.py, so a week of staleness is the worst case.
/og/*
  Cache-Control: public, max-age=604800

# The service worker script must never be served stale, or a fix cannot reach
# the browsers running the broken version. Browsers revalidate it anyway; this
# makes it explicit.
/freyacad/sw.js
  Cache-Control: no-cache
