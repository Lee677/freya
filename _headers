/freyacad/favicon.ico
  Cache-Control: public, max-age=604800
/freyacad/favicon.svg
  Cache-Control: public, max-age=604800
/grid/favicon.ico
  Cache-Control: public, max-age=604800
/grid/favicon.svg
  Cache-Control: public, max-age=604800
