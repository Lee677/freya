{
  "name": "freyacad",
  "short_name": "freyacad",
  "description": "Parametric CAD for 3D printing, in the browser",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    { "src": "icons/app-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/app-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./index.html?doc=part",
      "accept": { "application/x-freya-part": [".part", ".sketchcad"] },
      "icons": [{ "src": "icons/part-256.png", "sizes": "256x256", "type": "image/png" }]
    },
    {
      "action": "./index.html?doc=assembly",
      "accept": { "application/x-freya-assembly": [".assembly", ".asmcad"] },
      "icons": [{ "src": "icons/assembly-256.png", "sizes": "256x256", "type": "image/png" }]
    },
    {
      "action": "./index.html?doc=drawing",
      "accept": { "application/x-freya-drawing": [".drawing"] },
      "icons": [{ "src": "icons/drawing-256.png", "sizes": "256x256", "type": "image/png" }]
    }
  ]
}
